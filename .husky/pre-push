echo "Running 'npm run lint' before push..."
npm run lint

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Lint failed — push aborted. Fix the error above before pushing."
  exit 1
fi

echo "Running 'npm run build' before push..."
npm run build

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Build failed — push aborted. Fix the error above before pushing."
  exit 1
fi

echo "✅ Lint and build passed."
